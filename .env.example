# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bi-forecast

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-super-secret-encryption-key-change-this-in-production

# Google OAuth (for user authentication)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# QuickBooks Online OAuth
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_REDIRECT_URI=https://your-domain.com/.netlify/functions/qbo-oauth-callback

# Slack Notifications (nightly job failures, chart sharing, client revenue sharing)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C1234567890

# Site URL (for redirects)
URL=https://your-domain.com

# Environment
NODE_ENV=development

# Development: Bypass authentication on localhost (ONLY for local development)
# WARNING: NEVER set this to 'true' in production!
BYPASS_AUTH_LOCALHOST=false

# For production deployment, set NODE_ENV=production and ensure:
# - Strong JWT_SECRET and ENCRYPTION_KEY values (use crypto.randomBytes(32).toString('hex'))
# - Proper MongoDB connection with authentication
# - Valid OAuth client IDs and secrets
# - HTTPS URLs for all redirect URIs
# - Domain-restricted Google OAuth (authorized domains)
# - Secure MongoDB network access (IP whitelist or VPC)

# Extra origins allowed to call the functions (comma separated).
# Defaults to URL alone; falls back to '*' when neither is set.
ALLOWED_ORIGINS=

# Return error details in API responses. Off in production by default.
EXPOSE_ERROR_DETAILS=false
